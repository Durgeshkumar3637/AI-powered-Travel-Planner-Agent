# Demo mode: true = run without any API keys (mock Granite + demo weather)
DEMO_MODE=true

# IBM watsonx.ai / IBM Granite (required for real AI, set DEMO_MODE=false)
IBM_CLOUD_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL_ID=ibm/granite-3-3-8b-instruct

# Weather (OpenWeather). Leave empty to use demo weather data.
WEATHER_API_KEY=

# Frontend URL allowed by backend CORS
FRONTEND_URL=http://localhost:5173
